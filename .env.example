# =========================================================
# SecurePrompt AI - Environment Configuration
# =========================================================

# Google Gemini API Key Placeholder
# Replace "YOUR_GEMINI_API_KEY_HERE" with your actual Gemini API key from Google AI Studio.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional Firebase Service Account File Path
FIREBASE_SERVICE_ACCOUNT_PATH=firebase/firebase-key.json
